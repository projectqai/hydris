{
  "name": "@hydris/storybook",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=true storybook dev -p 6006",
    "build-storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=true storybook build",
    "test-storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=true TEST_INCLUDE_LIGHT_SCHEME=true vitest run",
    "dev:device": "cross-env STORYBOOK_DISABLE_TELEMETRY=true EXPO_NO_TELEMETRY=1 expo start",
    "export:android": "cross-env STORYBOOK_DISABLE_TELEMETRY=true EXPO_NO_TELEMETRY=1 expo export -p android --output-dir node_modules/.cache/android-export",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hydris/core": "workspace:*",
    "@hydris/ui": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@storybook/react-native": "^10.6.0",
    "expo": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-font": "catalog:",
    "expo-linear-gradient": "catalog:",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-css-interop": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:",
    "react-native-web": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@expo/metro": "catalog:",
    "@expo/metro-runtime": "catalog:",
    "@hydris/eslint-config": "workspace:*",
    "@hydris/tailwind-config": "workspace:*",
    "@hydris/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-native-web-vite": "^10.6.1",
    "@types/react": "catalog:",
    "@vitest/browser-playwright": "^5.0.3",
    "babel-preset-expo": "catalog:",
    "cross-env": "^10.1.0",
    "eslint": "catalog:",
    "playwright": "^1.64.0",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
