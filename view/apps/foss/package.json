    "sonner": "^2.0.7",
    "sonner-native": "^0.26.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/config": "catalog:",
    "@expo/config-types": "catalog:",
    "@expo/metro": "catalog:",
