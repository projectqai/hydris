    "jest-expo": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "zod": "^4.4.3"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ],
        "listUnknownPackages": false
      }
    }
  }
