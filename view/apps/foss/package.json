{
  "name": "@hydris/foss",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "dev:android": "expo run:android",
    "dev:web": "expo start --web",
    "build:android": "cross-env CI=1 NODE_ENV=production APP_ENV=production bun run build:android:exec",
    "build:android:staging": "cross-env CI=1 NODE_ENV=production APP_ENV=staging bun run build:android:exec",
    "build:android:dev": "cross-env CI=1 NODE_ENV=development APP_ENV=development bun run build:android:exec",
    "build:android:exec": "bunx expo prebuild --clean --platform android && cd android && ./gradlew clean assembleRelease",
    "build:web": "cross-env APP_ENV=production expo export -p web --output-dir ./build --clear",
    "build:web:staging": "cross-env APP_ENV=staging expo export -p web --output-dir ./build --clear",
    "serve": "expo serve ./build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@config-plugins/react-native-blob-util": "^14.0.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@hydris/core": "workspace:*",
    "@hydris/engine": "workspace:*",
    "@hydris/map-engine": "workspace:*",
    "@hydris/ui": "workspace:*",
    "@projectqai/proto": "catalog:",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "date-fns": "^4.4.0",
    "expo": "catalog:",
    "expo-asset": "~56.0.17",
    "expo-audio": "catalog:",
    "expo-battery": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-document-picker": "catalog:",
    "expo-font": "catalog:",
    "expo-haptics": "catalog:",
    "expo-image": "catalog:",
    "expo-keep-awake": "catalog:",
    "expo-linear-gradient": "catalog:",
