url = "git@github.com:projectqai/proto.git"

core.workflow(
    name = "default",
    origin = git.origin(
        url = ".",
        ref = "main",
    ),
    destination = git.destination(
        url = url,
        push = "main",
        fetch = "main",
    ),
    authoring = authoring.overwrite("Project Q <opensource@project-q.ai>"),
    origin_files = glob(
        ["proto/**"],
        exclude = [
            "proto/**/node_modules/**",
            "proto/rust/target/**",
        ],
    ),
    mode = "SQUASH",
    transformations = [
        core.move("proto", ""),
        metadata.replace_message("release"),
    ],
)
